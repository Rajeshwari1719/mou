NODE_ENV=development
PORT=4000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=college_mou_app
DB_PASSWORD=replace_with_a_local_secret
DB_NAME=college_mou_dev
JWT_SECRET=replace_with_at_least_32_random_bytes
CLIENT_ORIGINS=http://localhost:5173
UPLOAD_DIR=./uploads

# Bootstrap an initial administrator through the one-time create-admin script.
# Keep these values in a trusted server environment, never in client/VITE variables.
ADMIN_EMAIL=admin@example.invalid
ADMIN_PASSWORD=replace_with_at_least_16_characters
